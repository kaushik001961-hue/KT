generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum ProductType {
  IMPORT
  EXPORT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/**
 * =========================================================
 * ADMIN USER
 * =========================================================
 */

model AdminUser {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================================================
 * CATEGORY
 * =========================================================
 */

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String
  type        ProductType
  description String?
  active      Boolean     @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, type])
  @@index([type])
}

/**
 * =========================================================
 * REQUEST FOR QUOTE
 * =========================================================
 */

model RFQ {
  id String @id @default(cuid())

  rfqNumber String @unique

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  productType ProductType

  name    String
  company String?
  email   String
  phone   String?
  country String?

  destinationPort String?

  quantity String?
  unit     String?

  packaging String?
  incoterm  String?

  requiredDeliveryDate DateTime?

  requirements String?

  status RFQStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotation Quotation?

  @@index([productId])
  @@index([productType])
  @@index([status])
  @@index([country])
  @@index([createdAt])
}


/**
 * =========================================================
 * QUOTATION
 * =========================================================
 */

model Quotation {
  id String @id @default(cuid())

  quotationNumber String @unique

  rfqId String @unique
  rfq   RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  productName String
  productType ProductType

  buyerName    String
  buyerCompany String?
  buyerEmail   String
  buyerPhone   String?
  buyerCountry String?

  quantity String?
  unit     String?

  unitPrice   Decimal?
  totalAmount Decimal?

  currency Currency @default(USD)

  destinationPort String?
  incoterm        String?

  paymentTerms String?
  deliveryTerms String?
  deliveryTime String?

  validityDays Int @default(30)

  countryOfOrigin String?
  packaging       String?

  notes String?

  status QuotationStatus @default(DRAFT)

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([currency])
  @@index([createdAt])
}

/**
 * =========================================================
 * PRODUCT
 * =========================================================
 */

model Product {
  id     String        @id @default(cuid())
  name   String
  slug   String
  type   ProductType
  status ProductStatus @default(DRAFT)

  shortDescription     String?
  description          String?
  specifications       String?
  countryOfOrigin      String?
  packaging            String?
  minimumOrderQuantity String?

  featured Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images ProductImage[]
  rfqs   RFQ[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, type])
  @@index([type])
  @@index([status])
  @@index([categoryId])
  @@index([featured])
}

/**
 * =========================================================
 * PRODUCT IMAGES
 * =========================================================
 */

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

/**
 * =========================================================
 * PRODUCT ENQUIRIES
 * =========================================================
 */

model Enquiry {
  id String @id @default(cuid())

  productName String
  productType ProductType

  name    String
  company String?
  email   String
  phone   String?
  country String?

  quantity String?
  message  String?

  status EnquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productType])
  @@index([status])
  @@index([createdAt])
}

enum RFQStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_SENT
  NEGOTIATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum Currency {
  USD
  EUR
  GBP
  AED
  INR
}